# TeleArr - ejemplo de variables para Portainer Stack
TELEGRAM_BOT_TOKEN=

SONARR_URL=http://sonarr:8989
SONARR_API_TOKEN=

RADARR_URL=http://radarr:7878
RADARR_API_TOKEN=

ADMIN_PASSWORD=admin
SESSION_SECRET=change-me

SERIES_ROOT_FOLDER=/data/series
MOVIES_ROOT_FOLDER=/data/movies

# Fallback profile IDs (si no hay mapeo res|audio en config.yaml)
SERIES_QUALITY_PROFILE_ID=1
MOVIES_QUALITY_PROFILE_ID=1

# Presets por defecto para comandos y botones del bot
SERIES_DEFAULT_RESOLUTION=1080p
SERIES_DEFAULT_AUDIO=multi
MOVIES_DEFAULT_RESOLUTION=1080p
MOVIES_DEFAULT_AUDIO=multi
